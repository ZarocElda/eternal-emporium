# Use a dedicated database. Never place live credentials in this file.
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eternal_emporium_dev
SECRET_KEY=replace-with-a-long-random-value

# Phase 1 database controls
INITIALIZE_DATABASE=true
RUN_DB_MIGRATIONS=true
LEGACY_SCHEMA_BOOTSTRAP=true

# Optional integrations (leave blank in development to suppress notifications)
DISCORD_WEBHOOK_URL=
